# Copia para .env.local e preenche. Não commits o .env.local.
# Na Vercel: as mesmas chaves, em Sensitive.
# Sem estas vars o build continua a funcionar; blog/manifesto/X ficam vazios.
# Valores presentes são validados (URL, email, host Contentful) via src/shared/lib/env.ts.
#
# Contentful: usa só Content Delivery API (CDA) ou Preview.
#   CONTENTFUL_API_BASE_URL = https://cdn.contentful.com  (ou preview.contentful.com)
#   CONTENTFUL_API_ACCESS_TOKEN = token CDA/Preview — nunca Management (CMA) / api.contentful.com

CONTENTFUL_SPACE_ID=
CONTENTFUL_API_BASE_URL=https://cdn.contentful.com
CONTENTFUL_API_ACCESS_TOKEN=
# Delivery locale for API queries (default en-US). Validated via env.ts.
# Site UI lang is SITE_UI_LOCALE (pt-PT) in src/shared/lib/site.ts.
# CONTENTFUL_LOCALE=en-US


# Space-level webhook HMAC (Settings → Webhooks → Settings → Enable request verification).
# 64 chars. Required on Vercel Production + Preview; optional for local development.
# Comma-separate during rotation.
CONTENTFUL_WEBHOOK_SIGNING_SECRET=

REVALIDATE_SECRET=

ACCOUNT_MAIL=

# Homepage feed. Responses are cached for 60 seconds (not fetched on every visit).
SOCIAL_DATA_X_ACCOUNT=
# Host allowlisted in env.ts — only api.socialdata.tools
SOCIAL_DATA_BASE_URL=https://api.socialdata.tools
SOCIAL_DATA_API_KEY=
