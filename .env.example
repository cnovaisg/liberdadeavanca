# Copia para .env.local e preenche. Não faças commit do .env.local.
# Na Vercel: as mesmas chaves, em Sensitive.
# Sem estas variáveis o build continua a funcionar; o blog, o manifesto e o feed do X ficam vazios.
# Valores presentes são validados (URL, email, host do Contentful) em src/shared/lib/env.ts.
#
# Contentful: usa só a Content Delivery API (CDA) ou Preview.
#   CONTENTFUL_API_BASE_URL = https://cdn.contentful.com  (ou preview.contentful.com)
#   CONTENTFUL_API_ACCESS_TOKEN = token CDA/Preview — nunca Management (CMA) / api.contentful.com

CONTENTFUL_SPACE_ID=
CONTENTFUL_API_BASE_URL=https://cdn.contentful.com
CONTENTFUL_API_ACCESS_TOKEN=
# Ambiente do espaço. Por defeito master. Só letras, números, _ e -.
# CONTENTFUL_ENVIRONMENT=master
# Locale dos pedidos à Delivery API (por defeito en-US). Só BCP 47 (por exemplo en-US, pt-PT).
# A língua da interface é SITE_UI_LOCALE (pt-PT) em src/shared/lib/site.ts.
# CONTENTFUL_LOCALE=en-US

# Segredo HMAC do webhook, ao nível do espaço
# (Settings → Webhooks → Settings → Enable request verification).
# 64 caracteres. Obrigatório na Production e na Preview da Vercel; opcional em desenvolvimento local.
# Separa por vírgulas durante a rotação.
CONTENTFUL_WEBHOOK_SIGNING_SECRET=

REVALIDATE_SECRET=

# Origem pública do site, em https, sem caminho. Usada no robots.txt, no sitemap e em metadataBase.
# Por defeito https://liberdadeavanca.vercel.app
# SITE_URL=https://liberdadeavanca.vercel.app

ACCOUNT_MAIL=

# Feed da página inicial. As respostas ficam em cache 60 segundos (não há um pedido em cada visita).
SOCIAL_DATA_X_ACCOUNT=
# Host permitido em env.ts — só api.socialdata.tools
SOCIAL_DATA_BASE_URL=https://api.socialdata.tools
SOCIAL_DATA_API_KEY=
